+static UIImage *bundledMarkerImageForIdentifier(NSString *identifier) {
+    if (![identifier hasPrefix:@"asset-marker:"]) {
+        return nil;
+    }
+
+    NSArray<NSString *> *identifierParts = [identifier componentsSeparatedByString:@":"];
+    if (identifierParts.count < 2) {
+        return nil;
+    }
+
+    return [UIImage imageNamed:identifierParts[1]];
+}
+
+static UIImage *clusterMarkerImageForIdentifier(NSString *identifier) {
+    if (![identifier hasPrefix:@"cluster-marker:"]) {
+        return nil;
+    }
+
+    NSArray<NSString *> *identifierParts = [identifier componentsSeparatedByString:@":"];
+    if (identifierParts.count < 2) {
+        return nil;
+    }
+
+    NSString *clusterCount = identifierParts[1];
+    CGSize imageSize = CGSizeMake(50, 50);
+    UIGraphicsBeginImageContextWithOptions(imageSize, NO, 0.0);
+    CGContextRef context = UIGraphicsGetCurrentContext();
+    CGContextSetShadowWithColor(context, CGSizeMake(0, 1), 2, [UIColor colorWithWhite:0 alpha:0.3].CGColor);
+
+    UIBezierPath *circle = [UIBezierPath bezierPathWithOvalInRect:CGRectMake(2, 2, 46, 46)];
+    [[UIColor colorWithRed:145.0 / 255.0 green:13.0 / 255.0 blue:13.0 / 255.0 alpha:1.0] setFill];
+    [circle fill];
+    CGContextSetShadowWithColor(context, CGSizeZero, 0, nil);
+
+    NSDictionary *textAttributes = @{
+        NSFontAttributeName: [UIFont boldSystemFontOfSize:16],
+        NSForegroundColorAttributeName: UIColor.whiteColor,
+    };
+    CGSize textSize = [clusterCount sizeWithAttributes:textAttributes];
+    CGPoint textOrigin = CGPointMake(
+        (imageSize.width - textSize.width) / 2.0,
+        (imageSize.height - textSize.height) / 2.0
+    );
+    [clusterCount drawAtPoint:textOrigin withAttributes:textAttributes];
+
+    UIImage *clusterImage = UIGraphicsGetImageFromCurrentImageContext();
+    UIGraphicsEndImageContext();
+    return clusterImage;
+}
+
+static UIImage *markerImageForIdentifier(NSString *identifier) {
+    UIImage *bundledImage = bundledMarkerImageForIdentifier(identifier);
+    return bundledImage ?: clusterMarkerImageForIdentifier(identifier);
+}
+
 @interface AIRGoogleMapMarker ()
 @end
 
